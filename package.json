{
  "name": "portfolyo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "run-p content:dev next:dev",
    "next:dev": "next dev",
    "content:dev": "velite --watch",
    "build": "run-s content:build next:build",
    "next:build": "next build",
    "content:build": "velite --strict",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm content:build && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^24.1.3",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "velite": "^0.4.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
