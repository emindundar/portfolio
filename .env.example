# Contact form (Faz 1c). All optional: without them the form answers "unavailable" and points to LinkedIn.
# On Vercel: real keys in Production only; Preview gets only CONTACT_DRY_RUN=1. See README "Configuration".
RESEND_API_KEY=
# While CONTACT_FROM is the default this must be the Resend account's own address (any other recipient is rejected, 403).
CONTACT_TO=
# Default: Portfolio <onboarding@resend.dev> (delivers only to the Resend account owner). Use contact@<domain> once the domain is verified.
CONTACT_FROM=
TURNSTILE_SECRET_KEY=
# Both Turnstile values are needed. NEXT_PUBLIC_* is baked in at build time: redeploy after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 1 = validate and rate-limit, never verify or send (local work, e2e). Never set in production.
CONTACT_DRY_RUN=
# Analytics (Faz 1c)
NEXT_PUBLIC_UMAMI_ID=
# Optional, comma-separated hostnames allowed to report (e.g. emindundar.dev). Unset: the attribute is omitted.
NEXT_PUBLIC_UMAMI_DOMAINS=
